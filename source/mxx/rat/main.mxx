#ifndef APP_INCLUDE_STD
import std;
#else
#include <cstddef> // `size_t`
#include <exception> // `exception`
#include <filesystem> // `filesystem:path,canonical`
#include <fstream> // `ifstream`
#include <iostream> // `cerr`
#include <print> // `println`
#include <ranges> // `views:enumerate`
#include <stdexcept> // `runtime_error`
#include <string> // `string`
#include <string_view> // `string_view`
#include <vector> // `vector`
#endif//APP_INCLUDE_STD

namespace fs = std::filesystem;

namespace app {
    template< typename Type > using Out = Type &;
    template< typename Type > using Ref = Type const &;

    using std::println;
    using fs::canonical;
    using fs::file_size;
    using Path = fs::path;
    using Catch = Ref< std::exception >;
    using InputFile = std::ifstream;
    using Size = std::size_t;
    using Char = char;
    using Text = std::string;
    using View = std::string_view;
    template< typename Type > using Grow = std::vector< Type >;
    using GrowViews = Grow< View >;
    using std::views::enumerate;

    static constexpr Char New_Line = '\n';

    Text file_contents( Out< InputFile > file );
    GrowViews contents_to_lines( Ref< Text > text );
}

int main( int argc, char *argv[] ) try {
    using namespace app;
    println( "rats: Random Assets Tearing" );
    println( "\targc: {}, argv[0]: {}", argc, argv[0] );

    if ( argc != 2 ) throw std::runtime_error( "only works with two arguments" );

    Path path{ argv[1] };
    println( "path: {}", canonical( path ).string( ));

    Size fileSize = file_size( path );

    InputFile file{ path, std::ios::binary };

    if ( not file.is_open( )) throw std::runtime_error{ "cannot open file" };

    Text contents = app::file_contents( file );
    if ( contents.back( ) != New_Line ) contents.push_back( New_Line );
    GrowViews lines = contents_to_lines( contents );

    for ( auto line : lines ) println( "{}", line );

    file.close( );
} catch ( app::Catch e ) {
    std::println( std::cerr, "std::exception: {}", e.what( ));
} catch ( ... ) {
    std::println( std::cerr, "... exception" );
}

namespace app {

    Text
    file_contents( Out< InputFile > file ) {
        using It = std::istreambuf_iterator< typename InputFile::char_type >;
        return Text{ It{ file }, It{ }};
    }
    GrowViews
    contents_to_lines( Ref< Text > text ) {
        GrowViews lines;
        lines.reserve( text.size( ) >> 8u );

        Size prevIndex = 0;
        for ( auto [currIndex, c] : enumerate( text )) {
            if ( c != New_Line ) continue;
            lines.emplace_back( text.data( ) + prevIndex, std::min< Size >( 64, currIndex - prevIndex ));
            prevIndex = currIndex + 1;
        }
        return lines;
    }

}
