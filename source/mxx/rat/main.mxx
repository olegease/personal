#include <cassert>
import std;

namespace fs = std::filesystem;

namespace app {
    //using namespace std::string_view_literals;
    template< typename Type > using Ptr = Type *;
    template< typename Type > using Out = Type &;
    template< typename Type > using Ref = Type const &;

    using std::println;
    using std::format;
    using fs::file_size;
    using Path = fs::path;
    using Catch = Ref< std::exception >;
    using InputFile = std::ifstream;
    using Size = std::size_t;
    using Char = char;
    using Text = std::string;
    using View = std::string_view;
    using Args = std::span< Ptr< char >>;
    using Error = std::runtime_error;
    template< typename Type > using Grow = std::vector< Type >;
    using GrowViews = Grow< View >;
    // using std::views::enumerate; TODO: change to when clangd support it
    using std::views::iota;
    using std::views::zip;
    static constexpr Char New_Line = '\n';

    Text file_contents( Out< InputFile > file );
    GrowViews contents_to_lines( Ref< Text > text );

    struct App {
        static inline constexpr unsigned Show_Line_Threshold = 20u;
        GrowViews fileNames;
        Size currLine{ 1 };
        bool isShowNumbers{ };

        static bool is_show_line( unsigned threshold = Show_Line_Threshold ) {
            return Random::percent( ) <= threshold;
        }
        static void apply_seed( unsigned seed ) {
            static bool applied = false;
            assert( not applied and "apllied seed twice!" );
            Random::generator_.seed( seed );
            applied = true;
        }
    private:
        struct Random {
            static inline std::random_device device_;
            static inline std::mt19937 generator_{ device_( )};
            static inline std::uniform_int_distribution< unsigned > percent_{ 1, 100 };
            static unsigned percent( ) {
                return percent_( generator_ );
            }
        };
    };

    void print_lines( Out< App > appOut, Out< InputFile > file );
}

int main( int argc, char *argv[] ) try {
    using namespace app;

    App appOut{ }; // use write only
    Ref< App > app = appOut; // use to read only

    auto arg_size1 = [&appOut]( Char c ) {
        switch ( c ) {
            case 'n': appOut.isShowNumbers = true; break;
            default: throw Error{ format( "not supported one sized argument: {}", c )};
        }
    };

    Args args{ argv + 1, argc - 1u };
    for ( View arg : args ) {
        if ( arg[0] == '-' ) {
            Size argSize = arg.size( );
            switch ( argSize ) {
                case 2: arg_size1( arg[1] ); continue;
                default: throw Error{ format( "not supported arg: ", arg )};
            }
        }
        appOut.fileNames.push_back( arg );
    }

    for ( View fileName : app.fileNames ) {
        Path path{ fileName };

        Size fileSize = file_size( path );

        InputFile file{ path, std::ios::binary };
        if ( not file.is_open( )) throw Error{ format( "cannot open file: {}", path.string( ))};

        print_lines( appOut, file );
        file.close( );
    }

} catch ( app::Catch e ) {
    std::println( std::cerr, "std::exception: {}", e.what( ));
} catch ( ... ) {
    std::println( std::cerr, "... exception" );
} // main try

namespace app {

    Text
    file_contents( Out< InputFile > file ) {
        using It = std::istreambuf_iterator< typename InputFile::char_type >;
        return Text{ It{ file }, It{ }};
    }
    GrowViews
    contents_to_lines( Ref< Text > text ) {
        GrowViews lines;
        lines.reserve( std::max< Size >( text.size( ) >> 8u, 8u ));

        Size prevIndex = 0;
        // TODO: change to enumerate when clang supported
        for ( auto [currIndex, c] : zip( iota( 0 ), text )) {
            if ( c != New_Line ) continue;
            lines.emplace_back( text.data( ) + prevIndex, std::min< Size >( 64u, currIndex - prevIndex ));
            prevIndex = currIndex + 1;
        }

        return lines;
    }

    void
    print_lines( Out< App > appOut, Out< InputFile > file ) {
        auto const app = appOut;

        auto print_number_line = [&app]( long num, View line ) {
            if ( App::is_show_line( )) {
                println( "{:6d}\t{}", num + app.currLine, line );
            }
        };
        auto print_line = []( View line ) {
            if ( App::is_show_line( )) {
                println( "{}", line );
            }
        };

        Text contents = app::file_contents( file );
        if ( contents.back( ) != New_Line ) contents.push_back( New_Line );
        GrowViews lines = contents_to_lines( contents );
        if ( app.isShowNumbers ) {
            // TODO: change to enumerate when clang supported
            for ( auto [curr,line]: zip( iota( 0 ), lines )) {
                print_number_line( curr, line );
            }
            appOut.currLine += lines.size( );
        } else [[likely]] {
            for ( auto line: lines ) {
                print_line( line );
            }
        }
    }

} // namespace app `impl`
